+    }
+    return report.colors.find(color => color.role === section.color_role);
+  }
+
+  const BALANCE_TIPS = {
+    목: ['셔츠·양말의 작은 초록 포인트', '책상에 있는 화분이나 패브릭 소품', '시작할 일을 표시하는 노트 탭'],
