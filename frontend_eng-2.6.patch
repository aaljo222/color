+function ColorLink({ l }) {
+  const r = l.refs?.[0];
+  return (
+    <span className="why link">
+      색-감정 · {l.family}{r ? ` ↔ ${r.emotions.join("·") || "일관된 연합 없음"}` : ""} · {VERDICT[l.verdict]}
