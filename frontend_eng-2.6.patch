+      {r ? <> · <a href={r.url} target="_blank" rel="noreferrer">{r.citation.split(" (")[0]} {(r.citation.match(/\((\d{4})\)/) || [])[1] || ""}</a></> : null}
+    </span>
+  );
+}
+
+// 그리기 전 후보 색 (eng-2.6): 그림 뒤 4색은 이 안에서 골랐다
+function Candidates({ list }) {
+  return (
+    <details className="cands">
+      <summary>그리기 전 후보 {list.length}색 — 4색은 이 안에서 골랐습니다</summary>
+      <ul>
+        {list.map((c) => (
+          <li key={c.id} className={c.chosen ? "on" : ""}>
+            <span className="chip" style={{ background: c.hex }} />
+            <span>{c.id} {c.label}</span>
+            <small>{AXIS[c.origin] || c.origin} · {c.tier === "large" ? `넓게 ${Math.round(c.area_target * 100)}%` : "작게"} · 그림에서 {Math.round((c.painted_share || 0) * 100)}%</small>
+            <span className="num">{c.hex}</span>
+          </li>
+        ))}
+      </ul>
+    </details>
+  );
+}
